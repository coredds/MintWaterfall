{
  "name": "mintwaterfall",
  "version": "1.0.0",
  "description": "A powerful, D3.js-compatible waterfall chart component with enterprise features including breakdown analysis, conditional formatting, stacking capabilities, animations, and extensive customization options",
  "main": "dist/mintwaterfall.cjs",
  "module": "dist/mintwaterfall.esm.js",
  "browser": "dist/mintwaterfall.min.js",
  "unpkg": "dist/mintwaterfall.min.js",
  "jsdelivr": "dist/mintwaterfall.min.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mintwaterfall.esm.js",
      "require": "./dist/mintwaterfall.cjs",
      "browser": "./dist/mintwaterfall.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs 8080",
    "demo": "npm run build && node scripts/serve.mjs 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:fast": "jest --passWithNoTests --maxWorkers=4",
    "test:core": "jest tests/core-api.test.js tests/chart.test.js tests/data.test.js",
    "prebuild": "rimraf dist",
    "build": "rollup -c && npm run build:types",
    "build:fast": "rollup -c rollup.config.fast.js && npm run build:types",
    "build:full": "npm run build:ts && rollup -c && npm run build:types",
    "build:ts": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{js,ts}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{js,ts}\" \"*.{js,json,md}\""
  },
  "keywords": [
    "d3js",
    "d3",
    "waterfall",
    "chart",
    "visualization",
    "stacked",
    "data-viz",
    "svg",
    "interactive",
    "animation"
  ],
  "author": {
    "name": "David Duarte",
    "email": "david.duarte@outlook.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coredds/MintWaterfall.git"
  },
  "homepage": "https://coredds.github.io/MintWaterfall/",
  "bugs": {
    "url": "https://github.com/coredds/MintWaterfall/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@types/d3": "^7.0.0",
    "d3": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@types/d3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/d3": "^7.4.3",
    "babel-jest": "^30.0.5",
    "eslint": "^9.39.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-cleanup": "^3.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
